<% if(request.getAttribute("error")!=null){ %><div class="alert danger"><%=request.getAttribute("error")%></div><% } %><section class="panel form-panel"><form method="post" action="${pageContext.request.contextPath}/employees/save" class="employee-form" onsubmit="return validateEmployeeForm();"><input type="hidden" name="csrfToken" value="${requestScope.csrfToken}"><% if(request.getAttribute("employee")!=null){ %><input type="hidden" name="employeeId" value="${employee.employeeId}"><% } %><div class="form-section"><h2>Personal details</h2><div class="form-grid"><label>Full name<input name="fullName" required maxlength="120" value="${employee.fullName}"></label><label>Email address<input type="email" name="email" required maxlength="160" value="${employee.email}"></label><label>Phone number<input name="phone" required maxlength="30" value="${employee.phone}"></label><label>Address<input name="address" maxlength="500" value="${employee.address}"></label></div></div><div class="form-section"><h2>Employment details</h2><div class="form-grid"><label>Department<select name="department" required><option value="">Select department</option><option ${employee.department=='Engineering'?'selected':''}>Engineering</option><option ${employee.department=='Human Resources'?'selected':''}>Human Resources</option><option ${employee.department=='Design'?'selected':''}>Design</option><option ${employee.department=='Finance'?'selected':''}>Finance</option><option ${employee.department=='Marketing'?'selected':''}>Marketing</option></select></label><label>Job designation<input name="designation" required maxlength="100" value="${employee.designation}"></label><label>Annual salary (₹)<input type="number" min="0" step="0.01" name="salary" required value="${employee.salary}"></label><label>Joining date<input type="date" name="joiningDate" required value="${employee.joiningDate}"></label><label>Employment status<select name="employmentStatus" required><option ${employee.employmentStatus=='Active'?'selected':''}>Active</option><option ${employee.employmentStatus=='On Leave'?'selected':''}>On Leave</option><option ${employee.employmentStatus=='Inactive'?'selected':''}>Inactive</option></select></label></div></div><div class="form-actions"><a class="btn secondary" href="${pageContext.request.contextPath}/employees">Cancel</a><button class="btn primary" type="submit">Save employee <span>→</span></button></div></form></section>
