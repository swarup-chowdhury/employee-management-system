<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Employees | PeopleHub</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/styles.css"></head><body><%@ include file="fragments/sidebar.jspf" %><div class="shell"><%@ include file="fragments/header.jspf" %><main class="content"><div class="page-heading"><div><p class="eyebrow">DIRECTORY</p><h1>Employees</h1><p class="muted">Manage your organization’s employee records.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/employees/new">＋ Add employee</a></div><c:if test="${param.success != null}"><div class="alert success">Employee record ${param.success} successfully.</div></c:if><c:if test="${param.error != null}"><div class="alert danger">We could not complete that request.</div></c:if><section class="panel"><form class="filters" method="get"><div class="search-box">⌕<input name="search" value="${search}" placeholder="Search by name, email or ID"></div><select name="department"><option value="">All departments</option><option ${department=='Engineering'?'selected':''}>Engineering</option><option ${department=='Human Resources'?'selected':''}>Human Resources</option><option ${department=='Design'?'selected':''}>Design</option><option ${department=='Finance'?'selected':''}>Finance</option><option ${department=='Marketing'?'selected':''}>Marketing</option></select><select name="status"><option value="">All statuses</option><option ${status=='Active'?'selected':''}>Active</option><option ${status=='On Leave'?'selected':''}>On Leave</option><option ${status=='Inactive'?'selected':''}>Inactive</option></select><button class="btn secondary" type="submit">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Designation</th><th>Salary</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="e" items="${employees}"><tr><td><div class="person"><div class="avatar">${e.fullName.substring(0,1)}</div><div><strong>${e.fullName}</strong><small>${e.email}</small></div></div></td><td>${e.department}</td><td>${e.designation}</td><td>₹${e.salary}</td><td><span class="status ${e.employmentStatus=='Active'?'active':e.employmentStatus=='On Leave'?'leave':'inactive'}">${e.employmentStatus}</span></td><td class="actions"><a href="${pageContext.request.contextPath}/employees/edit?id=${e.employeeId}">Edit</a><form method="post" action="${pageContext.request.contextPath}/employees/delete" onsubmit="return confirm('Delete this employee record?');"><input type="hidden" name="csrfToken" value="${requestScope.csrfToken}"><input type="hidden" name="id" value="${e.employeeId}"><button type="submit">Delete</button></form></td></tr></c:forEach><c:if test="${empty employees}"><tr><td colspan="6"><div class="empty-state"><strong>No employees found</strong><span>Try changing your filters or add a new employee.</span></div></td></tr></c:if></tbody></table></div></section></main></div><%@ include file="fragments/footer.jspf" %></body></html>
