<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><!doctype html><html><head><title>Overview | PeopleHub</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/styles.css"></head><body><%@ include file="fragments/sidebar.jspf" %><div class="shell"><%@ include file="fragments/header.jspf" %><main class="content"><div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Good morning, ${sessionScope.adminUser}</h1><p class="muted">Here’s what’s happening across your organization today.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/employees/new">＋ Add employee</a></div><% if(request.getAttribute("error")!=null){ %><div class="alert danger"><%=request.getAttribute("error")%></div><% } %><section class="stats"><div class="stat-card"><div class="stat-icon blue">♙</div><span>Total employees</span><strong>${total}</strong><small>All employee records</small></div><div class="stat-card"><div class="stat-icon green">✓</div><span>Active employees</span><strong>${active}</strong><small>Currently working</small></div><div class="stat-card"><div class="stat-icon purple">⌁</div><span>Departments</span><strong>${departments}</strong><small>Across the organization</small></div><div class="stat-card"><div class="stat-icon orange">✦</div><span>Recently added</span><strong>${recent}</strong><small>Added in the last 30 days</small></div></section><section class="panel welcome-panel"><div><p class="eyebrow">QUICK START</p><h2>Keep your people data organized</h2><p class="muted">Add your latest team members, update their details, or use the employee directory to find anyone in seconds.</p><div class="quick-links"><a href="${pageContext.request.contextPath}/employees">Browse directory <span>→</span></a><a href="${pageContext.request.contextPath}/employees/new">Create employee record <span>→</span></a></div></div><div class="illustration"><div class="orb orb-one"></div><div class="orb 