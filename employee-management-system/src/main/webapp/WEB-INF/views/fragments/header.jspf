<header class="topbar"><div class="mobile-brand"><span class="brand-mark small">EMS</span><strong>PeopleHub</strong></div><button class="icon-button mobile-menu" onclick="document.body.classList.toggle('sidebar-open')">☰</button><div class="topbar-right"><span class="welcome">Good day, <strong>${sessionScope.adminUser}</strong></span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrfToken" value="${requestScope.csrfToken}"><button class="logout" type="submit">Sign out</button></form></div></header>
